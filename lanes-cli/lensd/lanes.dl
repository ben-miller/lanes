# Lanes' rule set for lensd. Symlink or copy into lensd's rules dir
# (default ~/.config/lensd/rules.d/lanes.dl); lensd then serves these
# relations on <server dir>/lanes.sock. Lanes maps the raw states below to
# signal reasons and applies its own dismissals (state.kdl) client-side.
#
# Every lane's repo must ALSO be watched via lensd/rules.d/repos.dl's own
# hand-maintained watch_repo list (that file is the single owner of the
# watch_repo control relation - see its own header comment). This set used
# to also derive watch_repo itself (`watch_repo(Path, Lane) :-
# lane_repo_path(Lane, Path).`), which silently raced repos.dl's own
# definition of the same relation on every startup: the engine treats two
# rule sets defining the same head as a conflict and drops the LOSING
# SET ENTIRELY (not just that one rule) - "left out", per its own
# rules_error wording - non-deterministically, by load order. That used to
# just mean this whole set sometimes silently went dark; once lensd's core
# `lanes` source started always emitting facts (like lane_boards_project,
# below) that only this set's own rules consume, losing that race started
# hard-crashing the daemon instead (any fact for a relation no loaded rule
# references is a panic - see engine.rs). Removed the derivation here
# rather than fix the race, since repos.dl already needs to be the lane-
# repo source of truth anyway (it also watches several non-lane repos).
# lanes_repo_watched below still works off existing git facts regardless
# of which rule set asked for them.
# Not derivable without negation (done client-side): "lane's Zellij session is
# not running" = lanes_session minus lanes_session_running, and "lane has no
# WezTerm tab" (SessionMissing) = lanes_session minus lanes_tab.

lanes_session(Lane, Zellij) :- lane_zellij(Lane, Zellij).
lanes_session_running(Lane, Zellij) :- lane_zellij(Lane, Zellij), zellij_session(Zellij).
lanes_claude(Lane, SessionId, State, Pane, Zellij) :- lane_zellij(Lane, Zellij), zellij_session(Zellij), claude_zellij(SessionId, Zellij, Pane), claude_session(SessionId, State).
lanes_command(Lane, Zellij, Pane, State, StartedAt) :- lane_zellij(Lane, Zellij), zellij_pane(Zellij, Pane), shell_command(Zellij, Pane, State), shell_command_started(Zellij, Pane, StartedAt).
lanes_command_cmd(Lane, Zellij, Pane, Cmd) :- lane_zellij(Lane, Zellij), zellij_pane(Zellij, Pane), shell_command_cmd(Zellij, Pane, Cmd).
lanes_command_exit(Lane, Zellij, Pane, Code) :- lane_zellij(Lane, Zellij), zellij_pane(Zellij, Pane), shell_command_exit(Zellij, Pane, Code).
lanes_command_ended(Lane, Zellij, Pane, At) :- lane_zellij(Lane, Zellij), zellij_pane(Zellij, Pane), shell_command_ended(Zellij, Pane, At).
lanes_pane(Lane, Zellij, Pane, TabPos, TabName, X, Y) :- lane_zellij(Lane, Zellij), zellij_pane_tab(Zellij, Pane, TabPos, TabName), zellij_pane_geom(Zellij, Pane, X, Y).
lanes_pane_cmd(Lane, Zellij, Pane, Cmd) :- lane_zellij(Lane, Zellij), zellij_pane_cmd(Zellij, Pane, Cmd).
lanes_pane_cwd(Lane, Zellij, Pane, Cwd) :- lane_zellij(Lane, Zellij), zellij_pane_cwd(Zellij, Pane, Cwd).
lanes_pane_focused(Lane, Zellij, Pane) :- lane_zellij(Lane, Zellij), zellij_pane_focused(Zellij, Pane).
lanes_repo_watched(Lane, Repo, Path) :- lane_repo_path(Lane, Path), repo_path(Repo, Path).
lanes_repo_dirty(Lane, Repo, Path) :- lane_repo_path(Lane, Path), repo_path(Repo, Path), dirty(Repo).
lanes_repo_branch(Lane, Repo, Current, Default, Path) :- lane_repo_path(Lane, Path), repo_path(Repo, Path), branch(Repo, Current), default_branch(Repo, Default), Current != Default.
lanes_tab(Lane, Tab) :- lane_zellij(Lane, Zellij), wezterm_tab_session(Tab, Zellij).
lanes_inbox_count(Lane, Project, Count) :- lane_boards_project(Lane, Project), board_inbox_count(Project, Count).
