dev:
	#!/usr/bin/env bash
	set -e
	# Only for an interactive terminal session you're running yourself -
	# Claude (or anything else invoking this non-interactively) must use
	# `just up`/`down`/`status` instead, so there's always a pidfile either
	# side can check and control rather than an untracked background job
	# only whoever started it knows about. Every non-interactive invocation
	# (including every one of Claude's own tool calls) has non-tty stdout,
	# so this check is a real guarantee, not a reminder to remember.
	if [ ! -t 1 ]; then
		echo "error: 'just dev' is for an interactive terminal only - use 'just up' for background/non-interactive use (e.g. from Claude)" >&2
		exit 1
	fi
	# This app depends on lanes-cli as a local path dependency - `tauri dev`'s
	# own watcher only looks at src-tauri, so a lanes-cli-only change never
	# triggers a rebuild and the running dev binary silently goes stale.
	# `tauri dev --additional-watch-folders <path>` claims to fix exactly
	# this but doesn't actually trigger a rebuild in practice (tested
	# directly against tauri-cli 2.11.1, twice: it logs "Watching ... for
	# changes" but a real content change in that folder never restarts the
	# app) - don't resurrect it.
	#
	# `cargo watch` wraps the whole `npm run tauri dev` process instead:
	# watches lanes-cli itself (bypassing tauri-cli's broken flag entirely),
	# and on a change kills the *entire* process tree it started (vite, the
	# lanes-ui binary, everything - via cargo-watch's own process-group
	# handling, not just the top pid) and restarts clean. Verified directly:
	# a real edit to lanes-cli/src/lib.rs produces a full fresh cycle (new
	# vite instance, recompiled `lanes` and `lanes-ui`, new pid) within a
	# few seconds. tauri-cli's own src-tauri watching is untouched by this -
	# cargo-watch only watches lanes-cli, so the two don't fight each other.
	cd src-tauri
	cargo watch -w ../../../lanes-cli -s 'cd .. && npm run tauri dev' -c

# Same dev pipeline as `just dev`, pidfile-tracked either way - per
# CONVENTIONS.md's "Running a long-lived local daemon" pattern (matching
# spinner/lensd): a pidfile is the single source of truth for "is it
# running and whose pid is it," so Claude and a human never raw-signal or
# pattern-kill past each other the way `nohup ... &` + `pkill -f` did
# before this existed.
#
# `just up` (no args): attached, like `docker run` without `-d` - logs
# stream straight to your terminal (no file, no tail), and Ctrl+C kills
# the *entire* app, not just a log view. This is the fix for a real bug:
# the previous version always backgrounded the app regardless of this
# flag and only ever let Ctrl+C stop a `tail -f` of it, so the app kept
# running invisibly no matter what you did short of `just down` - exactly
# the "Claude starts something and now you can't see or control it"
# problem this whole mechanism exists to prevent, just self-inflicted by
# this recipe's own design instead of by Claude.
# `just up -d`/`--detach`: detached, like `docker run -d` - starts it in
# the background, logs to a file, returns immediately.
up detach="":
	#!/usr/bin/env bash
	set -e
	PIDFILE="$HOME/.local/state/lanes/switch-ui-dev.pid"
	mkdir -p "$(dirname "$PIDFILE")"
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "already running (pid $(cat "$PIDFILE")) - run 'just down' first" >&2
		exit 1
	fi
	cd src-tauri

	if [ "{{detach}}" = "-d" ] || [ "{{detach}}" = "--detach" ]; then
		LOGFILE="$HOME/.local/state/lanes/logs/switch-ui-dev.log"
		mkdir -p "$(dirname "$LOGFILE")"
		set -m
		# The subshell becomes its own process group (set -m), so `down` can
		# kill the whole tree (cargo watch, npm, tauri, vite, the lanes-ui
		# binary) via that one group id, not just this top pid - killing
		# only the top pid doesn't cascade and leaves the rest running.
		( exec cargo watch -w ../../../lanes-cli -s 'cd .. && npm run tauri dev' -c ) > "$LOGFILE" 2>&1 &
		PID=$!
		disown
		echo "$PID" > "$PIDFILE"
		echo "lanes-ui dev: started (pid $PID), logging to $LOGFILE"
	else
		if [ ! -t 1 ]; then
			echo "error: 'just up' without --detach is for an interactive terminal only - use 'just up -d' for background/non-interactive use (e.g. from Claude)" >&2
			exit 1
		fi
		# Same explicit-group trick as the detached branch (set -m plus a
		# backgrounded subshell), not an inherited/ambient group - `$$`
		# here is NOT reliably this job's actual process group id (verified
		# directly: in one real run bash's own pid differed from its pgid,
		# because `just` had already placed this script into a group
		# whose original leader had since exited - an orphaned-but-valid
		# group, nothing wrong with it, just not equal to `$$`). Output is
		# left un-redirected (no log file) so it streams straight to this
		# terminal, same as `just dev`. An explicit trap on THIS wrapping
		# script forwards Ctrl+C to the actual group and cleans up the
		# pidfile - the wrapper itself stays in the terminal's foreground
		# group throughout, so it (not the backgrounded subshell) is what
		# actually receives the SIGINT.
		set -m
		( exec cargo watch -w ../../../lanes-cli -s 'cd .. && npm run tauri dev' -c ) &
		PID=$!
		echo "$PID" > "$PIDFILE"
		trap 'kill -TERM -"$PID" 2>/dev/null; rm -f "$PIDFILE"; exit 0' INT TERM
		wait "$PID"
		rm -f "$PIDFILE"
	fi

down:
	#!/usr/bin/env bash
	set -e
	PIDFILE="$HOME/.local/state/lanes/switch-ui-dev.pid"
	if [ ! -f "$PIDFILE" ]; then
		echo "lanes-ui dev: not running"
		exit 0
	fi
	PID="$(cat "$PIDFILE")"
	if kill -0 "$PID" 2>/dev/null; then
		kill -TERM -"$PID" 2>/dev/null || kill -TERM "$PID"
		echo "lanes-ui dev: stopped (pid $PID)"
	else
		echo "lanes-ui dev: not running (removing stale pidfile for pid $PID)"
	fi
	rm -f "$PIDFILE"

status:
	#!/usr/bin/env bash
	set -e
	PIDFILE="$HOME/.local/state/lanes/switch-ui-dev.pid"
	if [ ! -f "$PIDFILE" ]; then
		echo "lanes-ui dev: not running"
		exit 1
	fi
	PID="$(cat "$PIDFILE")"
	if kill -0 "$PID" 2>/dev/null; then
		echo "lanes-ui dev: running (pid $PID)"
	else
		echo "lanes-ui dev: not running (stale pidfile for pid $PID, removing)"
		rm -f "$PIDFILE"
		exit 1
	fi

# Tails the log just up/down's own output always points at - no need to
# remember or retype the path.
logs:
	#!/usr/bin/env bash
	set -e
	tail -f "$HOME/.local/state/lanes/logs/switch-ui-dev.log"

install:
	#!/usr/bin/env bash
	set -e
	npm run tauri build
	APP="src-tauri/target/release/bundle/macos/Lanes Switch.app"
	rm -rf "/Applications/Lanes Switch.app"
	cp -R "$APP" /Applications/
