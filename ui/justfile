# The dev app (and the lanes-cli watcher), under process-compose (what
# runs: ../process-compose.yaml): starts them in the background and follows
# their logs; Ctrl+C stops following, not them. Then, from anywhere:
# `dp ps logs lanes -f`, `dp ps down -p lanes`. (Just starting them, as
# Claude does: `dp ps up -d`.)
dev:
	dp ps up

install:
	#!/usr/bin/env bash
	set -e
	npm run tauri build
	APP="src-tauri/target/release/bundle/macos/Lanes Switch.app"
	rm -rf "/Applications/Lanes Switch.app"
	cp -R "$APP" /Applications/
