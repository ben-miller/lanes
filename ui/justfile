# The dev app, run and supervised by appctl (what it runs: appctl.toml).
# Attached: Ctrl+C stops the whole tree. For background use (including
# from Claude): `appctl up -d`, then `appctl status` / `logs -f` / `down`.
dev:
	appctl up

install:
	#!/usr/bin/env bash
	set -e
	npm run tauri build
	APP="src-tauri/target/release/bundle/macos/Lanes Switch.app"
	rm -rf "/Applications/Lanes Switch.app"
	cp -R "$APP" /Applications/
