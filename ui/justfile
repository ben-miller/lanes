# The dev app (and the lanes-cli watcher), under process-compose (what
# runs: ../process-compose.yaml), in the foreground like `docker compose
# up`: follows their logs, and Ctrl+C stops them. In the background instead
# (as Claude does): `dp ps up -d`, then `dp ps logs lanes -f` from
# anywhere, `dp ps down -p lanes`.
dev:
	dp ps up

install:
	#!/usr/bin/env bash
	set -e
	npm run tauri build
	APP="src-tauri/target/release/bundle/macos/Lanes Switch.app"
	rm -rf "/Applications/Lanes Switch.app"
	cp -R "$APP" /Applications/
