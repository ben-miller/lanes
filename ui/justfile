# The dev app (and the lanes-cli watcher), under process-compose (what
# runs: ../process-compose.yaml), attached in its TUI. For background use
# (including from Claude): `process-compose up -D`, then
# `process logs lanes -f` / `attach` / `down`.
dev:
	cd .. && process-compose up

install:
	#!/usr/bin/env bash
	set -e
	npm run tauri build
	APP="src-tauri/target/release/bundle/macos/Lanes Switch.app"
	rm -rf "/Applications/Lanes Switch.app"
	cp -R "$APP" /Applications/
